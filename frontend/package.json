{
  "name": "wx-miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "Taro 4 + React WeChat mini-program (H5-previewable) generated by AutoAgent",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "css"
  },
  "//": "Vite compiler (@tarojs/vite-runner): dev server does NOT bundle (native ESM + esbuild), so H5 dev-server memory + cold-start are far lower than webpack5 — which OOM-killed the H5 build in the 2Gi sandbox. NODE_OPTIONS heap cap kept as belt-and-suspenders.",
  "scripts": {
    "dev:h5": "NODE_OPTIONS=--max-old-space-size=1536 NODE_ENV=development taro build --type h5 --watch",
    "build:h5": "NODE_OPTIONS=--max-old-space-size=1536 NODE_ENV=production taro build --type h5",
    "dev:weapp": "NODE_OPTIONS=--max-old-space-size=1536 NODE_ENV=development taro build --type weapp --watch",
    "build:weapp": "NODE_OPTIONS=--max-old-space-size=1536 NODE_ENV=production taro build --type weapp",
    "test:acceptance": "vitest run"
  },
  "browserslist": [
    "last 3 Chrome versions",
    "last 3 Safari versions",
    "Android >= 5",
    "iOS >= 10"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@nutui/icons-react-taro": "3.0.1",
    "@tarojs/components": "4.2.0",
    "@tarojs/helper": "4.2.0",
    "@tarojs/plugin-framework-react": "4.2.0",
    "@tarojs/react": "4.2.0",
    "@tarojs/runtime": "4.2.0",
    "@tarojs/shared": "4.2.0",
    "@tarojs/taro": "4.2.0",
    "babel-preset-taro": "4.2.0",
    "clsx": "^2.1.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-proposal-decorators": "^7.24.1",
    "@babel/plugin-transform-class-properties": "^7.24.1",
    "@babel/preset-react": "^7.24.1",
    "@tarojs/cli": "4.2.0",
    "@tarojs/plugin-platform-h5": "4.2.0",
    "@tarojs/plugin-platform-weapp": "4.2.0",
    "@tarojs/vite-runner": "4.2.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "less": "^4.2.0",
    "postcss": "^8.5.6",
    "react-refresh": "^0.14.0",
    "terser": "^5.30.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.4.5",
    "vite": "^4.2.0",
    "vitest": "^1.6.0",
    "weapp-tailwindcss": "^4.10.3"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "neverBuiltDependencies": [
      "weapp-tailwindcss"
    ],
    "packageExtensions": {
      "@tarojs/plugin-platform-h5@*": {
        "dependencies": {
          "@tarojs/plugin-framework-react": "4.2.0"
        }
      },
      "@tarojs/router@*": {
        "dependencies": {
          "@tarojs/components": "4.2.0"
        }
      }
    }
  }
}
